# MongoDB Database Connection
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/itsmanuel?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/itsmanuel
MONGODB_URI=mongodb://localhost:27017/itsmanuel

# Admin Authentication Credentials (Editable anytime)
ADMIN_USERNAME=username
ADMIN_PASSWORD=password
ADMIN_SESSION_SECRET=manuel-admin-jwt-secret-key-2026-secure

# Gmail / SMTP Configuration
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Optional Custom SMTP Server (Defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000
