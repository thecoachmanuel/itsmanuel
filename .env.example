# Gmail / SMTP Configuration
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
CONTACT_RECEIVER_EMAIL=your_email@gmail.com # Where you want to receive messages (defaults to SMTP_USER if unset)

# Optional Custom SMTP Server (Defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000
